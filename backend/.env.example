# ─────────────────────────────────────────────
# English Coach Backend - Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Django settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# ─────────────────────────────────────────────
# AI Provider: choose 'ollama' or 'huggingface'
# ─────────────────────────────────────────────
AI_MODEL_PROVIDER=ollama

# --- Ollama settings (FREE, runs locally) ---
# Install Ollama from: https://ollama.ai
# Then run: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- HuggingFace settings (FREE API key required) ---
# Get a free key at: https://huggingface.co/settings/tokens
# Set AI_MODEL_PROVIDER=huggingface to use this
HF_API_KEY=your_huggingface_api_key_here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
